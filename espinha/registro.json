  "requisitos": [
    {
      "lei": "Lei 1",
      "verificador": "internal/fechar",
      "mecanico": true
    },
    {
      "lei": "Lei 2",
      "mecanico": false,
      "justificativa": "Conduta operacional de consulta ao grafo codebase-memory-mcp antes de leitura ampla; nao possui Gate estatico em Go."
    },
    {
      "lei": "Lei 3",
      "mecanico": false,
      "justificativa": "Politica de economia de tokens e concisao de resposta; avaliada por revisao de sessao."
    },
    {
      "lei": "Lei 4",
      "verificador": "internal/runner",
      "mecanico": true
    },
    {
      "lei": "Lei 5",
      "verificador": "go test -count=1 ./... && go build -o bin/legoloop.exe ./cmd/legoloop",
      "mecanico": true
    },
    {
      "lei": "Lei 6",
      "verificador": "internal/fechar",
      "mecanico": true
    },
    {
      "lei": "Lei 7",
      "mecanico": false,
      "justificativa": "Exigencia de idioma PT-BR em documentacao, planos e respostas; verificada em revisao."
    },
    {
      "lei": "Lei 8",
      "verificador": "go test -count=1 ./... && go vet ./... && go run ./tools/funclen internal && gofmt -l .",
      "mecanico": true
    },
    {
      "lei": "Lei 9",
      "mecanico": false,
      "justificativa": "Convencao de sintaxe de diagramas Mermaid em Markdown; nao ha validador estatico ativo na espinha."
    },
    {
      "lei": "Lei 10",
      "verificador": "internal/ste",
      "mecanico": true
    },
    {
      "lei": "Lei 11",
      "verificador": "internal/fechar",
      "mecanico": true
    },
    {
      "lei": "Lei 12",
      "verificador": "go run ./tools/taxlinter internal cmd loops skills docs/templates",
      "mecanico": true
    },
    {
      "lei": "Lei 13",
      "verificador": "internal/migrar",
      "mecanico": true
    },
    {
      "lei": "Lei 16",
      "verificador": "internal/brain; internal/espinha (debito-marcado); internal/progresso",
      "mecanico": true
    },
    {
      "lei": "Lei 17",
      "mecanico": false,
      "justificativa": "Regra de comunicacao com o usuario exigindo sugestao tecnica; verificada por revisao humana."
    },
    {
      "lei": "Lei 18",
      "verificador": "internal/upstream",
      "mecanico": true
    }
  ],
