{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "triagem.v1",
  "description": "Contrato triagem.v1 do processo: regras determinísticas, critério de ambiguidade, etapas e pontos de entrada. Gravado em processos/<slug>/triagem.json.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "triagem.v1" },
    "processo": { "type": "string" },
    "regras_deterministicas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "padrao_slug": { "type": "string" },
          "comandos_cli": { "type": ["array", "null"], "items": { "type": "string" } },
          "artefatos_ativos": { "type": ["array", "null"], "items": { "type": "string" } },
          "prioridade": { "type": "integer" }
        },
        "required": ["padrao_slug", "comandos_cli", "prioridade"]
      }
    },
    "criterio_ambiguidade": {
      "type": "object",
      "properties": {
        "descricao": { "type": "string" },
        "etapas": { "type": ["array", "null"], "items": { "type": "string" } }
      },
      "required": ["descricao"]
    },
    "etapas": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "palavras_chave": { "type": ["array", "null"], "items": { "type": "string" } },
          "slash_command": { "type": "string" },
          "flag_cli": { "type": "string" }
        },
        "required": ["id"]
      }
    },
    "pontos_entrada": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["schema_version", "processo", "regras_deterministicas", "criterio_ambiguidade", "pontos_entrada"]
}
