{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "name": "legoloop-video-motion",
  "version": "1.0.0",
  "date": "2026-11-07",
  "description": "Processo canônico de motion design determinístico para vídeos com silêncios +40ms, tipografia cinética e cartões 3D",
  "upstream_signatures": {
    "intent": "9812a677fbca05619985ea15858022b7c02bda6396919db45873919e86bf79e8",
    "spec": "ec6576b22ba8fe6cb30d24bf51a37c9a419eb9338f977c0500e2ea024f9e1189",
    "plan": "2b6b66e138a0c20beceb43f9ba6be91e528dbe4cbf5e59b9a695d7eb8f1eeae3",
    "route": "docs/routes/2026-11-07_ROUTE_VIDEO_MOTION_PIPELINE.json"
  },
  "execution_strategy": {
    "supervision_level": "micro",
    "concurrency": {
      "mode": "sequential",
      "max_parallel_subagents": 1,
      "harness_capability": "subagent_cli_isolated"
    },
    "default_isolation": {
      "workspace": "local",
      "executor": "orchestrix_hermetic",
      "subagents_allowed": false
    },
    "max_parallel_workers": 1,
    "tdd_enforced": true,
    "default_timeout_sec": 300,
    "rollback_on_failure": "abort"
  },
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "n01_silence_clock",
      "name": "Detecção de Silêncios e Fatiamento de Pausas com Folga de 40ms",
      "nature": "micro",
      "cognitive_complexity": "simples",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "isolation": {
        "workspace": "local",
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false
      },
      "token_budget": {
        "max_prompt_tokens": 8000,
        "max_completion_tokens": 2000
      },
      "tooling": {
        "runtime": "powershell"
      },
      "timeout_sec": 180,
      "execution": {
        "mode": "isolated"
      },
      "context_in": [
        "docs/specs/2026-11-07_SPEC_VIDEO_MOTION_PIPELINE.md"
      ],
      "context_out": [
        "scratch/videomotion/words.json"
      ],
      "status": "COMPLETED",
      "command": [
        "legoloop",
        "video-motion",
        "silence",
        "--input",
        "input.mp4",
        "--out",
        "scratch/videomotion/words.json"
      ],
      "output": {
        "artifact": "scratch/videomotion/words.json",
        "gate": "file_exists('scratch/videomotion/words.json')"
      },
      "test_seam": {
        "type": "unit_test_gate",
        "target": "internal/videomotion/videomotion_test.go"
      }
    },
    {
      "id": "n02_punch_detector",
      "name": "Detecção de Palavras de Impacto e RMS de Punch Visual",
      "nature": "micro",
      "cognitive_complexity": "simples",
      "type": "script",
      "depends_on": [
        "n01_silence_clock"
      ],
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "isolation": {
        "workspace": "local",
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false
      },
      "token_budget": {
        "max_prompt_tokens": 8000,
        "max_completion_tokens": 2000
      },
      "tooling": {
        "runtime": "powershell"
      },
      "timeout_sec": 180,
      "execution": {
        "mode": "isolated"
      },
      "context_in": [
        "scratch/videomotion/words.json"
      ],
      "context_out": [
        "scratch/videomotion/punched_words.json"
      ],
      "status": "COMPLETED",
      "command": [
        "legoloop",
        "video-motion",
        "punch",
        "--words",
        "scratch/videomotion/words.json",
        "--out",
        "scratch/videomotion/punched_words.json"
      ],
      "output": {
        "artifact": "scratch/videomotion/punched_words.json",
        "gate": "file_exists('scratch/videomotion/punched_words.json')"
      },
      "test_seam": {
        "type": "unit_test_gate",
        "target": "internal/videomotion/videomotion_test.go"
      }
    },
