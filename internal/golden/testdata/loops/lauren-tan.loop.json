{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "id": "lauren-tan",
  "name": "Pipeline Lauren Tan pstack (6 Sub-Loops)",
  "description": "Pipeline de rigor de engenharia baseado no método Lauren Tan (pstack / poteto-mode): Intenção & Modelagem de Domínio -> Arquitetura & Exploração -> Decomposição em Unidades Verificáveis -> Construção Rigorosa TDD -> Verificação Formal no Artefato Real -> Higiene de Código (Unslop) & Ship.",
  "version": "1.0.0",
  "date": "2026-11-09",
  "upstream_signatures": {
    "intent": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "spec": "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb",
    "plan": "4e07408562bedb8b60ce05c1decfe3ad16b72230967de01f640b7e4729b49fce",
    "route": "docs/routes/2026-11-09_ROUTE_LAUREN_TAN.json"
  },
  "execution_strategy": {
    "supervision_level": "micro",
    "concurrency": {
      "mode": "sequential",
      "max_parallel_subagents": 1,
      "harness_capability": "subagent_cli_isolated"
    },
    "default_isolation": {
      "workspace": "local",
      "executor": "orchestrix_hermetic",
      "subagents_allowed": false
    },
    "max_parallel_workers": 1,
    "tdd_enforced": true,
    "default_timeout_sec": 300,
    "rollback_on_failure": "abort_pipeline",
    "rollback_policy": {
      "action": "abort_and_pause",
      "git_strategy": "checkpoint_commit",
      "preserve_artifacts": true,
      "commit_on_node_pass": true
    }
  },
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "subloop-1-intencao-dominio",
      "name": "Intenção & Modelagem de Domínio",
      "nature": "micro",
      "cognitive_complexity": "medio",
      "type": "skill",
      "ref": "skills/aidd-lauren",
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "token_budget": {
        "input_tokens": 4000,
        "output_tokens": 1500
      },
      "isolation": {
        "workspace": "local",
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false
      },
      "inputs": {
        "intent_dir": "file('docs/intents/')"
