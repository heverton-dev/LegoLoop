      "context_out": [
        "internal/cli/autopilot.go"
      ],
      "test_seam": {
        "type": "unit_test_gate",
        "target": "exit_code == 0 && file_exists('internal/cli/autopilot.go')"
      },
      "output": {
        "artifact": "internal/cli/autopilot.go",
        "gate": "exit_code == 0 && file_exists('internal/cli/autopilot.go')"
      }
    }
