{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "name": "legoloop-n10-foundry",
  "version": "1.0.0",
  "date": "2026-11-09",
  "description": "Processo canônico da Fundição Autônoma de Software LegoLoop com Protocolos Industriais e Motores de Fronteira N10",
  "upstream_signatures": {
