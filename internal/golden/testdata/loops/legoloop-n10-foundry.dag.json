      "type": "script",
      "command": ["go", "version"],
      "nature": "micro",
      "depends_on": ["n01_contracts_and_schemas"],
      "routing": {
        "mode": "manual",
        "model": "code-fast",
        "effort": "medium"
      },
      "context_in": [
        "schemas/dag.v1.json"
      ],
      "context_out": [
        "internal/runner/retry.go"
      ],
      "test_seam": {
        "type": "unit_test_gate",
        "target": "exit_code == 0 && file_exists('internal/runner/retry.go')"
      },
      "output": {
        "artifact": "internal/runner/retry.go",
        "gate": "exit_code == 0 && file_exists('internal/runner/retry.go')"
      }
    },
    {
      "id": "n03_n10_frontier_engines",
      "name": "Motores de Fronteira Industrial N10",
      "type": "script",
      "command": ["go", "version"],
      "nature": "micro",
      "depends_on": ["n02_andon_and_sbar"],
      "routing": {
        "mode": "manual",
        "model": "code-pro",
        "effort": "high"
