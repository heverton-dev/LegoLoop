  "execution_strategy": {
    "supervision_level": "micro",
    "max_parallel_workers": 2,
    "default_timeout_sec": 300,
    "rollback_on_failure": "abort_and_pause",
    "rollback_policy": {
      "action": "abort_and_pause",
      "git_strategy": "checkpoint_commit",
      "preserve_artifacts": true,
      "commit_on_node_pass": true
    }
  },
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "n01_contracts_and_schemas",
      "name": "Saneamento de Schemas e Proveniência de Contexto",
      "type": "script",
      "command": ["go", "version"],
      "nature": "micro",
      "routing": {
        "mode": "manual",
        "model": "code-fast",
        "effort": "medium"
      },
      "context_in": [],
      "context_out": [
        "schemas/dag.v1.json"
      ],
      "test_seam": {
        "type": "schema_gate",
        "target": "exit_code == 0 && file_exists('schemas/dag.v1.json')"
      },
      "output": {
        "artifact": "schemas/dag.v1.json",
        "gate": "exit_code == 0 && file_exists('schemas/dag.v1.json')"
      }
    },
    {
      "id": "n02_andon_and_sbar",
