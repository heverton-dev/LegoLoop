{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "id": "mega-pipeline",
  "name": "Mega Processo LegoLoop (6 Subprocessos)",
  "description": "Processo mestre determinístico com os 6 subprocessos canônicos: Concepção & Alinhamento -> Engenharia Reversa & Design Pass -> Tríade de Planejamento -> Construção TDD por Épico -> Homologação E2E -> Fechamento Canônico Universal.",
  "version": "1.0.0",
  "date": "2026-11-09",
  "upstream_signatures": {
    "intent": "9812a677fbca05619985ea15858022b7c02bda6396919db45873919e86bf79e8",
    "spec": "ec6576b22ba8fe6cb30d24bf51a37c9a419eb9338f977c0500e2ea024f9e1189",
