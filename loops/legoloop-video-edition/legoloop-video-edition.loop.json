        "-vn",
        "-acodec",
        "pcm_s16le",
        "-ar",
        "48000",
        "-ac",
        "2",
        "docs/videorea/lucas-leite-edicao-claude-code/scratch/audio_extracted.wav"
      ],
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "effort": "low",
        "fallback": "flash"
      },
      "isolation": {
        "workspace": "local",
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false
      },
      "token_budget": {
        "max_prompt_tokens": 8000,
        "max_completion_tokens": 2000
      },
