      "routing": {
        "mode": "manual",
        "harness": "claude",
        "via": "oficial",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "context_in": [],
      "context_out": [
        "schemas/dag.v1.json"
      ],
      "isolation": {
        "write_boundary": "strict",
        "workspace": "local",
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false
      },
      "limits": {
        "max_prompt_tokens": 8000,
        "max_completion_tokens": 2500,
        "max_duration_sec": 300
      },
      "rollback_strategy": "stash_changes",
      "tooling": {
        "runtime": "powershell",
        "harness": "claude"
      },
      "verification": {
        "exit_code": 0,
        "gate": "exit_code == 0 && file_exists('schemas/dag.v1.json')"
