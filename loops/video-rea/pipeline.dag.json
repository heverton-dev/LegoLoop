{
  "name": "legoloop-video-rea",
  "version": "1.0.0",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "n01_crawler_ingest",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "command": [
        "legoloop",
        "video-rea",
        "ingest",
        "--url",
        "https://www.youtube.com/watch?v=FJZkfjM8WhI",
        "--out",
        "scratch/videorea/raw.json"
      ],
      "output": {
        "artifact": "scratch/videorea/raw.json",
        "gate": "file_exists('scratch/videorea/raw.json')"
      }
    },
    {
      "id": "n02_forensics_dissection",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "depends_on": [
        "n01_crawler_ingest"
      ],
      "command": [
        "legoloop",
        "video-rea",
        "forensics",
        "--input",
        "scratch/videorea/raw.json",
        "--out",
        "scratch/videorea/dossier.json"
      ],
      "output": {
        "artifact": "scratch/videorea/dossier.json",
        "gate": "file_exists('scratch/videorea/dossier.json')"
      }
    },
    {
      "id": "n03_matrix_curation",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "depends_on": [
        "n02_forensics_dissection"
      ],
      "command": [
        "legoloop",
        "video-rea",
        "curate",
        "--dossier",
        "scratch/videorea/dossier.json",
        "--out",
        "scratch/videorea/curation.json"
      ],
      "output": {
        "artifact": "scratch/videorea/curation.json",
        "gate": "file_exists('scratch/videorea/curation.json')"
      }
    },
    {
      "id": "n04_stopgate_approval",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "haiku",
        "fallback": "flash"
      },
      "depends_on": [
        "n03_matrix_curation"
      ],
      "command": [
        "legoloop",
        "video-rea",
        "gate",
        "--report",
        "scratch/videorea/curation.json"
      ],
      "output": {
        "artifact": "scratch/videorea/approval.json",
        "gate": "file_exists('scratch/videorea/approval.json')"
      }
    },
    {
      "id": "n05_governance_factory",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "depends_on": [
        "n04_stopgate_approval"
      ],
      "command": [
        "legoloop",
        "video-rea",
        "govern",
        "--approval",
        "scratch/videorea/approval.json",
        "--out",
        "docs/generated/"
      ],
      "output": {
        "artifact": "docs/generated/manifest.json",
        "gate": "file_exists('docs/generated/manifest.json')"
      }
    },
    {
      "id": "n06_legopress_book",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "depends_on": [
        "n05_governance_factory"
      ],
      "command": [
        "legoloop",
        "video-rea",
        "book",
        "--manifest",
        "docs/generated/manifest.json"
      ],
      "output": {
        "artifact": "docs/books/video-rea/livro.json",
        "gate": "file_exists('docs/books/video-rea/livro.json')"
      }
    }
  ]
}
