{
  "name": "legoloop-canal-redc",
  "version": "1.0.0",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "n01_catalogar_clusterizar",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "command": [
        "powershell",
        "-NoProfile",
        "-Command",
        "Test-Path internal/redc/catalog.go"
      ],
      "output": {
        "artifact": "internal/redc/catalog.go",
        "gate": "file_exists('internal/redc/catalog.go')"
      }
    },
    {
      "id": "n02_deep_redc_dna",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-pro",
        "fallback": "flash"
      },
      "depends_on": [
        "n01_catalogar_clusterizar"
      ],
      "command": [
        "powershell",
        "-NoProfile",
        "-Command",
        "Test-Path internal/redc/dna.go"
      ],
      "output": {
        "artifact": "internal/redc/dna.go",
        "gate": "file_exists('internal/redc/dna.go')"
      }
    },
    {
      "id": "n03_gerar_pipelines_metodos",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-pro",
        "fallback": "flash"
      },
      "depends_on": [
        "n02_deep_redc_dna"
      ],
      "command": [
        "powershell",
        "-NoProfile",
        "-Command",
        "Test-Path internal/redc/pipeline_gen.go"
      ],
      "output": {
        "artifact": "internal/redc/pipeline_gen.go",
        "gate": "file_exists('internal/redc/pipeline_gen.go')"
      }
    },
    {
      "id": "n04_gerador_brand_swap",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-pro",
        "fallback": "flash"
      },
      "depends_on": [
        "n02_deep_redc_dna"
      ],
      "command": [
        "powershell",
        "-NoProfile",
        "-Command",
        "Test-Path internal/redc/brand_swap.go"
      ],
      "output": {
        "artifact": "internal/redc/brand_swap.go",
        "gate": "file_exists('internal/redc/brand_swap.go')"
      }
    }
  ]
}