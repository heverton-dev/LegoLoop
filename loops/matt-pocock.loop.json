{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "id": "matt-pocock",
  "name": "Pipeline de Rigor Matt Pocock (6 Sub-Loops)",
  "description": "Pipeline determinístico de engenharia baseado no método Matt Pocock: Grilling & Alinhamento de Domínio -> Desvio Empírico/Protótipo -> Especificação & Tickets em Grafo -> Construção TDD Cirúrgica -> Code Review de 2 Eixos -> Retroalimentação do Ambiente.",
  "version": "1.0.0",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "subloop-1-alinhar-dominio",
      "type": "skill",
      "ref": "skills/aidd-pocock",
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "fallback": "haiku"
      },
      "output": {
        "artifact": "GLOSSARY.md",
        "gate": "file_exists('GLOSSARY.md')"
      }
    },
    {
      "id": "subloop-2-especificar",
      "type": "skill",
      "ref": "skills/aidd-pocock",
      "depends_on": [
        "subloop-1-alinhar-dominio"
      ],
      "routing": {
        "mode": "auto",
        "combo": "code-pro"
      },
      "inputs": {
        "glossario": "file('GLOSSARY.md')"
      },
      "output": {
        "artifact": "docs/specs/SPEC.md",
        "gate": "file_exists('docs/specs/SPEC.md')"
      }
    },
    {
      "id": "subloop-3-planejar-tickets",
      "type": "skill",
      "ref": "skills/aidd-pocock",
      "depends_on": [
        "subloop-2-especificar"
      ],
      "routing": {
        "mode": "auto",
        "combo": "code-fast"
      },
      "inputs": {
        "spec": "file('docs/specs/SPEC.md')"
      },
      "output": {
        "artifact": "docs/plans/PLAN.md",
        "gate": "file_exists('docs/plans/PLAN.md')"
      }
    },
    {
      "id": "subloop-4-construir-tdd",
      "type": "skill",
      "ref": "skills/aidd-pocock",
      "depends_on": [
        "subloop-3-planejar-tickets"
      ],
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "fallback": "qwen2.5-coder:7b"
      },
      "inputs": {
        "plano": "file('docs/plans/PLAN.md')"
      },
      "output": {
        "artifact": "docs/reports/TDD_REPORT.md",
        "gate": "file_exists('docs/reports/TDD_REPORT.md')"
      }
    },
    {
      "id": "subloop-5-review-auditar",
      "type": "skill",
      "ref": "skills/aidd-pocock",
      "depends_on": [
        "subloop-4-construir-tdd"
      ],
      "routing": {
        "mode": "auto",
        "combo": "code-fast"
      },
      "inputs": {
        "tdd": "file('docs/reports/TDD_REPORT.md')"
      },
      "output": {
        "artifact": "docs/reports/CODE_REVIEW.md",
        "gate": "file_exists('docs/reports/CODE_REVIEW.md')"
      }
    },
    {
      "id": "subloop-6-retro-ambiente",
      "type": "skill",
      "ref": "skills/aidd-pocock",
      "depends_on": [
        "subloop-5-review-auditar"
      ],
      "routing": {
        "mode": "auto",
        "combo": "code-fast"
      },
      "inputs": {
        "review": "file('docs/reports/CODE_REVIEW.md')"
      },
      "output": {
        "artifact": "docs/reports/RETRO.md",
        "gate": "file_exists('docs/reports/RETRO.md')"
      }
    }
  ]
}
