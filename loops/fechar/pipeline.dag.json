{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "name": "legoloop-fechar",
  "version": "1.0.0",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "n01_manual_check",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "command": [
        "legoloop",
        "fechar",
        "video-motion",
        "--dry-run",
        "--skip-build"
      ],
      "output": {
        "artifact": "docs/manuals/2026-11-07_MANUAL_FUNCAO_FECHAR_LEGOLOOP.md",
        "gate": "file_exists('docs/manuals/2026-11-07_MANUAL_FUNCAO_FECHAR_LEGOLOOP.md')"
      }
    },
    {
      "id": "n02_book_legopress",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "depends_on": [
        "n01_manual_check"
      ],
      "command": [
        "legoloop",
        "legopress",
        "auditar",
        "docs/books/video-rea/2026-11-07_PIPELINE-VIDEO-REA.pdf"
      ],
      "output": {
        "artifact": "docs/books/video-rea/livro.json",
        "gate": "file_exists('docs/books/video-rea/livro.json')"
      }
    },
    {
      "id": "n03_skill_harnesses",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "depends_on": [
        "n02_book_legopress"
      ],
      "command": [
        "legoloop",
        "instalar-skills",
        "--dry-run"
      ],
      "output": {
        "artifact": "skills/legoloop-fechar/SKILL.md",
        "gate": "file_exists('skills/legoloop-fechar/SKILL.md')"
      }
    },
    {
      "id": "n04_dag_validation",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "depends_on": [
        "n03_skill_harnesses"
      ],
      "command": [
        "legoloop",
        "validate",
        "loops/video-motion/pipeline.dag.json"
      ],
      "output": {
        "artifact": "loops/video-motion/pipeline.dag.json",
        "gate": "file_exists('loops/video-motion/pipeline.dag.json')"
      }
    },
    {
      "id": "n05_rebuild_binary",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "depends_on": [
        "n04_dag_validation"
      ],
      "command": [
        "legoloop",
        "version"
      ],
      "output": {
        "artifact": "bin/legoloop.exe",
        "gate": "file_exists('bin/legoloop.exe')"
      }
    },
    {
      "id": "n06_governance_sync",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "depends_on": [
        "n05_rebuild_binary"
      ],
      "command": [
        "legoloop",
        "doctor",
        "--json"
      ],
      "output": {
        "artifact": "AGENTS.md",
        "gate": "file_exists('AGENTS.md')"
      }
    },
    {
      "id": "n07_report_telemetry",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "depends_on": [
        "n06_governance_sync"
      ],
      "command": [
        "legoloop",
        "fechar",
        "video-motion",
        "--dry-run"
      ],
      "output": {
        "artifact": "docs/templates/TEMPLATE_REPORT.md",
        "gate": "file_exists('docs/templates/TEMPLATE_REPORT.md')"
      }
    }
  ]
}
