{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "name": "video-motion",
  "version": "1.0.0",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "n01_silence_clock",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "command": [
        "legoloop",
        "video-motion",
        "silence",
        "--input",
        "input.mp4",
        "--out",
        "scratch/videomotion/words.json"
      ],
      "output": {
        "artifact": "scratch/videomotion/words.json",
        "gate": "file_exists('scratch/videomotion/words.json')"
      }
    },
    {
      "id": "n02_punch_detector",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "command": [
        "legoloop",
        "video-motion",
        "punch",
        "--words",
        "scratch/videomotion/words.json",
        "--out",
        "scratch/videomotion/punched_words.json"
      ],
      "depends_on": [
        "n01_silence_clock"
      ],
      "output": {
        "artifact": "scratch/videomotion/punched_words.json",
        "gate": "file_exists('scratch/videomotion/punched_words.json')"
      }
    },
    {
      "id": "n03_asset_synthesis",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "command": [
        "legoloop",
        "video-motion",
        "assets",
        "--words",
        "scratch/videomotion/punched_words.json",
        "--out",
        "scratch/videomotion/assets_manifest.json"
      ],
      "depends_on": [
        "n02_punch_detector"
      ],
      "output": {
        "artifact": "scratch/videomotion/assets_manifest.json",
        "gate": "file_exists('scratch/videomotion/assets_manifest.json')"
      }
    },
    {
      "id": "n04_motion_preview",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "command": [
        "legoloop",
        "video-motion",
        "preview",
        "--assets",
        "scratch/videomotion/assets_manifest.json",
        "--out",
        "scratch/videomotion/qa_sheet.jpg"
      ],
      "depends_on": [
        "n03_asset_synthesis"
      ],
      "output": {
        "artifact": "scratch/videomotion/qa_sheet.jpg",
        "gate": "file_exists('scratch/videomotion/qa_sheet.jpg')"
      }
    },
    {
      "id": "n05_render_bundle",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "command": [
        "legoloop",
        "video-motion",
        "bundle",
        "--preview",
        "scratch/videomotion/qa_sheet.jpg",
        "--out",
        "dist/bundle_manifest.json"
      ],
      "depends_on": [
        "n04_motion_preview"
      ],
      "output": {
        "artifact": "dist/bundle_manifest.json",
        "gate": "file_exists('dist/bundle_manifest.json')"
      }
    },
    {
      "id": "n06_legopress_manual",
      "type": "script",
      "routing": {
        "mode": "suggested",
        "model": "code-fast",
        "fallback": "flash"
      },
      "command": [
        "legoloop",
        "legopress",
        "build",
        "--manifest",
        "docs/manuals/livro-video-motion/livro.json"
      ],
      "depends_on": [
        "n05_render_bundle"
      ],
      "output": {
        "artifact": "docs/manuals/livro-video-motion/livro.json",
        "gate": "file_exists('docs/manuals/livro-video-motion/livro.json')"
      }
    }
  ]
}