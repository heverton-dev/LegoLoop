{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "id": "legoloop-auditoria-atomica",
  "name": "legoloop-auditoria-atomica",
  "description": "Auditar qualquer alvo com critério binário e emitir veredito com evidências",
  "version": "1.0.0",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "e01_dissecao",
      "name": "Dissecar o alvo da auditoria",
      "type": "skill",
      "nature": "micro",
      "cognitive_complexity": "simples",
      "ref": "skills/legoloop-auditoria-atomica",
      "timeout_sec": 600,
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "code-fast"
      },
      "output": {
        "artifact": "out/01_dissecao.md",
        "gate": "file_exists('out/01_dissecao.md') \u0026\u0026 word_count('out/01_dissecao.md') \u003e= 30 \u0026\u0026 !has_pattern('out/01_dissecao.md', '\\{\\{')"
      },
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local"
      },
      "token_budget": {
        "max_completion_tokens": 3000,
        "max_prompt_tokens": 10000
      },
      "tooling": {
        "runtime": "powershell"
      },
      "context_out": [
        "out/01_dissecao.md"
      ],
      "status": "PENDING"
    },
    {
