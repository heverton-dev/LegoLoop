{
  "$schema": "https://legoloop.dev/schemas/dag.v2.json",
  "id": "legoloop-kraften-deploy",
  "name": "legoloop-kraften-deploy",
  "version": "1.0.0",
  "schema_version": 2,
  "date": "2026-11-26",
  "description": "Processo determinístico de deploy do Studio Launcher (zero LLM): preflight anti-zip-slip dos 3 artefatos universais, sincronização de metadados e CNAME Cloudflare, deploy com stream do deploy-job, gates binários (CF_OLD=0, CF_NEW=1, TLS=0, HTTP=200) e recibo DEPLOY_RECEIPT.json auditável.",
  "upstream_signatures": {
    "intent": "docs/intents/2026-11-26_INTENT_TRANSFORMAR_O_PIPELINE_DE_DEPL.md",
    "spec": "docs/specs/2026-11-26_SPEC_KRAFTEN_DEPLOY.md",
    "plan": "docs/plans/2026-11-26_PLAN_KRAFTEN_DEPLOY.md",
    "route": "docs/routes/2026-11-26_ROUTE_KRAFTEN_DEPLOY.json"
  },
  "execution_strategy": {
    "supervision_level": "epic",
    "concurrency": {
      "mode": "sequential",
      "max_parallel_subagents": 0,
      "harness_capability": "subagent_cli_isolated"
    },
    "default_isolation": {
      "workspace": "local",
      "executor": "orchestrix_hermetic",
      "subagents_allowed": false,
      "write_boundary": "strict"
    },
    "max_parallel_workers": 1,
    "tdd_enforced": true,
    "default_timeout_sec": 300,
    "rollback_on_failure": "abort_and_pause",
    "rollback_policy": {
      "action": "abort_and_pause",
      "git_strategy": "none",
      "preserve_artifacts": true,
      "commit_on_node_pass": false
    }
  },
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "n01_preflight_zip",
      "name": "Preflight do pacote: extração anti-zip-slip e validação dos 3 artefatos universais",
      "nature": "micro",
      "type": "script",
      "command": ["legoloop", "kraften-deploy", "preflight", "--zip", "$ZIP", "--dest", "."],
      "ref": "legoloop kraften-deploy preflight",
      "routing": {"mode": "manual", "harness": "legoloop", "via": "oficial", "model": "none", "effort": "low", "fallback": "none"},
      "timeout_sec": 60,
      "isolation": {"executor": "orchestrix_hermetic", "subagents_allowed": false, "workspace": "local", "write_boundary": "strict"},
      "tooling": {"runtime": "legoloop"},
      "context_in": [],
      "context_out": ["preflight.json"],
      "output": {"artifact": "preflight.json", "gate": "exit_code == 0"},
      "spec_ref": "AC-E01.1",
      "status": "pending",
      "execution": {"mode": "isolated"},
      "limits": {"max_attempts": 1, "timeout_seconds": 60},
      "rollback_strategy": "abort_and_pause",
      "verification": {"gate": "exit_code == 0"},
      "depends_on": []
    },
    {
      "id": "n02_sync_metadata",
      "name": "Sincronização de metadados e criação idempotente do CNAME Cloudflare antes de qualquer consulta DNS",
      "nature": "micro",
      "type": "script",
      "command": ["legoloop", "kraften-deploy", "sync", "--app", "$APP", "--subdominio", "$SUBDOMINIO", "--alvo", "$ALVO", "--launcher", "$LAUNCHER", "--user", "$USER", "--pass", "$PASS", "--cloudflare", "$CLOUDFLARE", "--zone", "$ZONE", "--token", "$TOKEN", "--dest", "."],
      "ref": "legoloop kraften-deploy sync",
      "routing": {"mode": "manual", "harness": "legoloop", "via": "oficial", "model": "none", "effort": "low", "fallback": "none"},
      "timeout_sec": 60,
      "isolation": {"executor": "orchestrix_hermetic", "subagents_allowed": false, "workspace": "local", "write_boundary": "strict"},
      "tooling": {"runtime": "legoloop"},
      "context_in": ["preflight.json"],
      "context_out": ["sync.json"],
      "output": {"artifact": "sync.json", "gate": "exit_code == 0"},
      "spec_ref": "AC-E01.4",
      "status": "pending",
      "execution": {"mode": "isolated"},
      "limits": {"max_attempts": 1, "timeout_seconds": 60},
      "rollback_strategy": "abort_and_pause",
      "verification": {"gate": "exit_code == 0"},
      "depends_on": ["n01_preflight_zip"]
    },
    {
      "id": "n03_deploy_stream",
      "name": "Envio do .zip e acompanhamento do deploy-job até status done",
      "nature": "micro",
      "type": "script",
      "command": ["legoloop", "kraften-deploy", "deploy", "--app", "$APP", "--zip", "$ZIP", "--launcher", "$LAUNCHER", "--user", "$USER", "--pass", "$PASS", "--acao", "$ACAO", "--dest", "."],
      "ref": "legoloop kraften-deploy deploy",
      "routing": {"mode": "manual", "harness": "legoloop", "via": "oficial", "model": "none", "effort": "low", "fallback": "none"},
      "timeout_sec": 300,
      "isolation": {"executor": "orchestrix_hermetic", "subagents_allowed": false, "workspace": "local", "write_boundary": "strict"},
      "tooling": {"runtime": "legoloop"},
      "context_in": ["sync.json"],
      "context_out": ["deploy.json"],
      "output": {"artifact": "deploy.json", "gate": "exit_code == 0"},
      "spec_ref": "AC-E02.1",
      "status": "pending",
      "execution": {"mode": "isolated"},
      "limits": {"max_attempts": 1, "timeout_seconds": 300},
      "rollback_strategy": "abort_and_pause",
      "verification": {"gate": "exit_code == 0"},
      "depends_on": ["n02_sync_metadata"]
    },
    {
      "id": "n04_verify_gates",
      "name": "Gates binários de verificação: CF_OLD=0, CF_NEW=1, TLS=0 e HTTP=200",
      "nature": "micro",
      "type": "script",
      "command": ["legoloop", "kraften-deploy", "gates", "--health", "$HEALTH", "--host-novo", "$HOST_NOVO", "--host-antigo", "$HOST_ANTIGO", "--cloudflare", "$CLOUDFLARE", "--zone", "$ZONE", "--token", "$TOKEN", "--dest", "."],
      "ref": "legoloop kraften-deploy gates",
      "routing": {"mode": "manual", "harness": "legoloop", "via": "oficial", "model": "none", "effort": "low", "fallback": "none"},
      "timeout_sec": 60,
      "isolation": {"executor": "orchestrix_hermetic", "subagents_allowed": false, "workspace": "local", "write_boundary": "strict"},
      "tooling": {"runtime": "legoloop"},
      "context_in": ["deploy.json"],
      "context_out": ["gates.json"],
      "output": {"artifact": "gates.json", "gate": "exit_code == 0"},
      "spec_ref": "AC-E02.2",
      "status": "pending",
      "execution": {"mode": "isolated"},
      "limits": {"max_attempts": 1, "timeout_seconds": 60},
      "rollback_strategy": "abort_and_pause",
      "verification": {"gate": "exit_code == 0"},
      "depends_on": ["n03_deploy_stream"]
    },
    {
      "id": "n05_receipt",
      "name": "Emissão do recibo DEPLOY_RECEIPT.json auditável",
      "nature": "micro",
      "type": "script",
      "command": ["legoloop", "kraften-deploy", "receipt", "--app", "$APP", "--dest", "."],
      "ref": "legoloop kraften-deploy receipt",
      "routing": {"mode": "manual", "harness": "legoloop", "via": "oficial", "model": "none", "effort": "low", "fallback": "none"},
      "timeout_sec": 30,
      "isolation": {"executor": "orchestrix_hermetic", "subagents_allowed": false, "workspace": "local", "write_boundary": "strict"},
      "tooling": {"runtime": "legoloop"},
      "context_in": ["gates.json"],
      "context_out": ["DEPLOY_RECEIPT.json"],
      "output": {"artifact": "DEPLOY_RECEIPT.json", "gate": "exit_code == 0"},
      "spec_ref": "AC-NF.1",
      "status": "pending",
      "execution": {"mode": "isolated"},
      "limits": {"max_attempts": 1, "timeout_seconds": 30},
      "rollback_strategy": "abort_and_pause",
      "verification": {"gate": "exit_code == 0"},
      "depends_on": ["n04_verify_gates"]
    }
  ]
}
