{
  "$schema": "https://legoloop.dev/schemas/dag.v2.json",
  "id": "legoloop-planejamento",
  "name": "legoloop-planejamento",
  "version": "1.0.0",
  "schema_version": 2,
  "date": "2026-11-23",
  "description": "Processo canônico de Planejamento (legoloop-planejamento): gera formalmente PLAN, ROUTE e DAG a partir de uma SPEC aprovada e tickets técnicos com trava de integridade upstream.",
  "upstream_signatures": {
    "spec": "docs/specs/SPEC.md",
    "template_plan": "docs/templates/TEMPLATE_PLAN.md"
  },
  "execution_strategy": {
    "supervision_level": "micro",
    "concurrency": {
      "mode": "sequential",
      "max_parallel_subagents": 1,
      "harness_capability": "subagent_cli_isolated"
    },
    "default_isolation": {
      "workspace": "local",
      "executor": "orchestrix_hermetic",
      "subagents_allowed": false
    },
    "max_parallel_workers": 1,
    "tdd_enforced": true,
    "default_timeout_sec": 300,
    "rollback_on_failure": "abort_and_pause",
    "rollback_policy": {
      "action": "abort_and_pause",
      "git_strategy": "none",
      "preserve_artifacts": true,
      "commit_on_node_pass": false
    }
  },
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "gerar_plano",
      "name": "Geração formal de PLAN, ROUTE e DAG pelo comando legoloop fabricar plano",
      "nature": "micro",
      "type": "script",
      "command": [
        "legoloop",
        "fabricar",
        "plano",
        "--spec",
        "docs/specs/SPEC.md",
        "--tickets",
        "docs/plans/tickets.json"
      ],
      "ref": "legoloop fabricar plano",
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "effort": "high",
        "fallback": "opus",
        "harness": "claude",
        "via": "9router"
      },
      "timeout_sec": 300,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "docs/specs/SPEC.md",
        "docs/plans/tickets.json"
      ],
      "context_out": [
        "docs/plans/PLAN.md",
        "docs/routes/ROUTE.json",
        "docs/dags/DAG.json"
      ],
      "output": {
        "artifact": "docs/plans/PLAN.md",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-E04.3",
      "status": "pending",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 300
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "exit_code == 0"
      }
    },
    {
      "id": "stop_gate_03",
      "name": "Stop-Gate 03 humano de validação e aprovação do plano de execução",
      "nature": "nano",
      "type": "stop_gate",
      "depends_on": [
        "gerar_plano"
      ],
      "routing": {
        "mode": "manual",
        "model": "haiku",
        "effort": "low",
        "fallback": "sonnet",
        "harness": "claude",
        "via": "9router"
      },
      "timeout_sec": 3600,
      "isolation": {
        "executor": "local_process",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "docs/plans/PLAN.md",
        "docs/routes/ROUTE.json",
        "docs/dags/DAG.json"
      ],
      "context_out": [
        "docs/plans/PLAN_APROVADO.md"
      ],
      "output": {
        "artifact": "docs/plans/PLAN_APROVADO.md",
        "gate": "prompt('Aprovar o plano de execução gerado em docs/plans/PLAN.md?')"
      },
      "spec_ref": "AC-E04.1",
      "status": "pending",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 3600
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "prompt('Aprovar o plano de execução gerado em docs/plans/PLAN.md?')"
      }
    }
  ]
}