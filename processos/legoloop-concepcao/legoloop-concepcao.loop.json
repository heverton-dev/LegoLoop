{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "id": "legoloop-concepcao",
  "name": "legoloop-concepcao",
  "version": "1.0.0",
  "date": "2026-11-16",
  "description": "Subprocesso único de Concepção e Alinhamento de Intenção: entrevista socrática pelo motor oficial legoloop fabricar entrevista até confiança maior ou igual a 95% com Espelho Canônico, INTERVIEW gravada, INTENT materializada em docs/intents/ e Stop-Gate 01 humano de aprovação.",
  "upstream_signatures": {
    "ideia": "entrada em linguagem natural do usuário",
    "interview": "INTERVIEW gravada (sessão intv_* no cofre de sessões)",
    "template_intent": "docs/templates/TEMPLATE_INTENT.md"
  },
  "execution_strategy": {
    "supervision_level": "micro",
    "max_parallel_workers": 1,
    "default_timeout_sec": 1800,
    "rollback_on_failure": "abort_and_pause"
  },
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "entrevista_socratica",
      "name": "Entrevista Socrática com Espelho Canônico até confiança maior ou igual a 95%",
      "type": "script",
      "nature": "micro",
      "command": [
        "legoloop",
        "fabricar",
        "entrevista",
        "iniciar"
      ],
      "depends_on": [],
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "effort": "high"
      },
      "context_in": [
        "docs/intents/"
      ],
      "context_out": [
        "docs/intents/INTERVIEW.md"
      ],
      "output": {
        "artifact": "docs/intents/INTERVIEW.md",
        "gate": "exit_code == 0"
      }
    },
    {
      "id": "interview_gravada",
      "name": "INTERVIEW gravada no cofre e Espelho Canônico consolidado em registro",
      "type": "unit_no",
      "nature": "micro",
      "depends_on": [
        "entrevista_socratica"
      ],
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "effort": "medium"
      },
      "context_in": [
        "docs/intents/INTERVIEW.md"
      ],
      "context_out": [
        "docs/intents/ESPELHO_CANONICO.md"
      ],
      "output": {
        "artifact": "docs/intents/ESPELHO_CANONICO.md",
        "gate": "file_exists('docs/intents/ESPELHO_CANONICO.md')"
      }
    },
    {
      "id": "materializar_intent",
      "name": "Materialização da INTENT em docs/intents/ a partir do Espelho Canônico",
      "type": "script",
      "nature": "micro",
      "command": [
        "legoloop",
        "fabricar",
        "entrevista",
        "intent"
      ],
      "depends_on": [
        "interview_gravada"
      ],
      "routing": {
        "mode": "suggested",
        "model": "haiku",
        "effort": "low"
      },
      "context_in": [
        "docs/intents/ESPELHO_CANONICO.md"
      ],
      "context_out": [
        "docs/intents/INTENT.md"
      ],
      "output": {
        "artifact": "docs/intents/INTENT.md",
        "gate": "file_exists('docs/intents/INTENT.md')"
      }
    },
    {
      "id": "stop_gate_01",
      "name": "Stop-Gate 01 humano de aprovação da INTENT",
      "type": "stop_gate",
      "nature": "nano",
      "depends_on": [
        "materializar_intent"
      ],
      "routing": {
        "mode": "manual",
        "model": "haiku",
        "effort": "low"
      },
      "context_in": [
        "docs/intents/INTENT.md"
      ],
      "context_out": [
        "docs/intents/INTENT_APROVADA.md"
      ],
      "output": {
        "artifact": "docs/intents/INTENT_APROVADA.md",
        "gate": "prompt('Aprovar a INTENT materializada em docs/intents/INTENT.md?')"
      }
    }
  ]
}
