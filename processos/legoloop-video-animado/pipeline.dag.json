{
  "$schema": "https://legoloop.dev/schemas/dag.v2.json",
  "id": "legoloop-video-animado",
  "name": "legoloop-video-animado",
  "version": "1.0.0",
  "schema_version": 2,
  "date": "2026-11-27",
  "description": "Macroprocesso composto legoloop-video-animado: encadeia P1 (roteiro), P2 (ativos/storyboard), P3 (render 9:16 com motor local) e P4 (distribuicao e publicacao), com gate final de prova e ritmo no alvo (12 a 21 cortes/min).",
  "upstream_signatures": {
    "intent": "docs/intents/2026-11-26_EMENDA_INTENT_APROVADA_VIDEO_ANIMADO.md",
    "spec": "docs/specs/2026-11-26_SPEC_VIDEO_ANIMADO_V2.md",
    "plan": "docs/plans/2026-11-26_PLAN_APROVADO_VIDEO_ANIMADO.md",
    "route": "docs/routes/2026-11-26_ROUTE_VIDEO_ANIMADO_V2.json"
  },
  "execution_strategy": {
    "supervision_level": "micro",
    "concurrency": {
      "mode": "sequential",
      "max_parallel_subagents": 1,
      "harness_capability": "subagent_cli_isolated"
    },
    "default_isolation": {
      "workspace": "local",
      "executor": "orchestrix_hermetic",
      "subagents_allowed": false
    },
    "max_parallel_workers": 1,
    "tdd_enforced": true,
    "default_timeout_sec": 600,
    "rollback_on_failure": "abort_and_pause",
    "rollback_policy": {
      "action": "abort_and_pause",
      "git_strategy": "none",
      "preserve_artifacts": true,
      "commit_on_node_pass": false
    }
  },
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "n01_video_roteiro",
      "name": "P1: Subprocesso legoloop-video-roteiro (Configuracao, Pautas e Roteiro)",
      "nature": "micro",
      "type": "subprocesso",
      "ref": "legoloop-video-roteiro",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "timeout_sec": 600,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "projeto.json"
      ],
      "context_out": [
        "projeto.json",
        "marca.json",
        "script.json",
        "plano.md"
      ],
      "output": {
        "artifact": "script.json",
        "gate": "file_exists('script.json')"
      },
      "spec_ref": "AC-E06.1",
      "status": "pending",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 600
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "file_exists('script.json')"
      },
      "depends_on": []
    },
    {
      "id": "n02_video_ativos",
      "name": "P2: Subprocesso legoloop-video-ativos (Inventario, Elenco Vetorial, Cenarios e Storyboard)",
      "nature": "micro",
      "type": "subprocesso",
      "ref": "legoloop-video-ativos",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "timeout_sec": 600,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "projeto.json",
        "script.json",
        "inventario/video/estilos/*/estilo.json"
      ],
      "context_out": [
        "cenas.json"
      ],
      "output": {
        "artifact": "cenas.json",
        "gate": "file_exists('cenas.json')"
      },
      "spec_ref": "AC-E07.1..AC-E09.5",
      "status": "pending",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 600
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "file_exists('cenas.json')"
      },
      "depends_on": [
        "n01_video_roteiro"
      ]
    },
    {
      "id": "n03_video_render",
      "name": "P3: Subprocesso legoloop-video-render (Voz, Whisper, Timeline, Mix e Render 9:16)",
      "nature": "micro",
      "type": "subprocesso",
      "ref": "legoloop-video-render",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "timeout_sec": 600,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "projeto.json",
        "script.json",
        "cenas.json"
      ],
      "context_out": [
        "render.mp4",
        "timeline.json"
      ],
      "output": {
        "artifact": "render.mp4",
        "gate": "file_exists('render.mp4')"
      },
      "spec_ref": "AC-E10.1..AC-E10.8",
      "status": "pending",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 600
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "file_exists('render.mp4')"
      },
      "depends_on": [
        "n02_video_ativos"
      ]
    },
    {
      "id": "n04_video_distribuicao",
      "name": "P4: Subprocesso legoloop-video-distribuicao (Revisao sem Contexto, Vitrine, Agenda e Publicacao)",
      "nature": "micro",
      "type": "subprocesso",
      "ref": "legoloop-video-distribuicao",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "timeout_sec": 600,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "render.mp4",
        "script.json"
      ],
      "context_out": [
        "acervo/aprendizado.md"
      ],
      "output": {
        "artifact": "acervo/aprendizado.md",
        "gate": "file_exists('acervo/aprendizado.md')"
      },
      "spec_ref": "AC-E11.1..AC-E11.4",
      "status": "pending",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 600
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "file_exists('acervo/aprendizado.md')"
      },
      "depends_on": [
        "n03_video_render"
      ]
    },
    {
      "id": "n05_prova_reproducao",
      "name": "Gate final de prova e reproducao em video real com ritmo no alvo (12 a 21 cortes/min)",
      "nature": "macro",
      "type": "script",
      "command": [
        "legoloop",
        "video-render",
        "executar",
        "--projeto",
        "."
      ],
      "ref": "legoloop video-render executar",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "timeout_sec": 600,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "timeline.json",
        "renders/cena1.mp4"
      ],
      "context_out": [
        "renders/cena1.mp4"
      ],
      "output": {
        "artifact": "renders/cena1.mp4",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-E12.1..AC-E12.3",
      "status": "pending",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 3,
        "timeout_seconds": 600
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "exit_code == 0"
      },
      "depends_on": [
        "n04_video_distribuicao"
      ]
    }
  ]
}
