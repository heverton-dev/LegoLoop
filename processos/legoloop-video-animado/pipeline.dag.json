{
  "$schema": "https://legoloop.dev/schemas/dag.v2.json",
  "id": "legoloop-video-animado",
  "name": "legoloop-video-animado",
  "version": "1.0.0",
  "schema_version": 2,
  "date": "2026-11-26",
  "description": "Macroprocesso legoloop-video-animado: inventario global por estilo, contratos novos, Peca 2 vetorial, motor portado com licenca MIT, renomeacao diorama->video e prova de reproducao (SPEC v2, Epicos E07 a E12).",
  "upstream_signatures": {
    "intent": "docs/intents/2026-11-26_EMENDA_INTENT_APROVADA_VIDEO_ANIMADO.md",
    "spec": "docs/specs/2026-11-26_SPEC_VIDEO_ANIMADO_V2.md",
    "plan": "docs/plans/2026-11-26_PLAN_APROVADO_VIDEO_ANIMADO.md",
    "route": "docs/routes/2026-11-26_ROUTE_VIDEO_ANIMADO_V2.json"
  },
  "execution_strategy": {
    "supervision_level": "micro",
    "concurrency": {
      "mode": "sequential",
      "max_parallel_subagents": 1,
      "harness_capability": "subagent_cli_isolated"
    },
    "default_isolation": {
      "workspace": "local",
      "executor": "orchestrix_hermetic",
      "subagents_allowed": false
    },
    "max_parallel_workers": 1,
    "tdd_enforced": true,
    "default_timeout_sec": 180,
    "rollback_on_failure": "abort_and_pause",
    "rollback_policy": {
      "action": "abort_and_pause",
      "git_strategy": "none",
      "preserve_artifacts": true,
      "commit_on_node_pass": false
    }
  },
  "nodes": [
    {
      "id": "n01_inventario_por_estilo",
      "name": "Inventario global por estilo: NovoEstilo, GravarItem, heranca e validacao humana (Epico E07)",
      "nature": "macro",
      "type": "script",
      "command": [
        "legoloop",
        "video-inventario",
        "verificar",
        "--estilo",
        "molde-de-pilula",
        "--json"
      ],
      "ref": "legoloop video-inventario verificar",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "timeout_sec": 300,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "docs/specs/2026-11-26_SPEC_VIDEO_ANIMADO_V2.md"
      ],
      "context_out": [
        "inventario/video/estilos/*/estilo.json"
      ],
      "output": {
        "artifact": "inventario/video/estilos/molde-de-pilula/estilo.json",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-E07.1..AC-E07.9",
      "status": "done",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 300
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "exit_code == 0"
      },
      "depends_on": []
    },
    {
      "id": "n02_contratos_v2",
      "name": "Contratos v2: pre-voo le modo_producao e estilo validado, storyboard confere elenco e inventario (Epico E08)",
      "nature": "macro",
      "type": "script",
      "command": [
        "legoloop",
        "video-ativos",
        "prevoo",
        "--projeto",
        ".",
        "--json"
      ],
      "ref": "legoloop video-ativos prevoo",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "timeout_sec": 300,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "projeto.json"
      ],
      "context_out": [
        "prevoo_ativos.json"
      ],
      "output": {
        "artifact": "prevoo_ativos.json",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-E08.1..AC-E08.3",
      "status": "done",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 300
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "exit_code == 0"
      },
      "depends_on": [
        "n01_inventario_por_estilo"
      ]
    },
    {
      "id": "n03_peca2_vetorial",
      "name": "Peca 2: elenco vetorial do inventario sem Flow, caminho de recorte preservado, entrega suspeita marcada (Epico E09)",
      "nature": "macro",
      "type": "script",
      "command": [
        "legoloop",
        "video-ativos",
        "executar",
        "--projeto",
        ".",
        "--json"
      ],
      "ref": "legoloop video-ativos executar",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "timeout_sec": 300,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "script.json",
        "inventario/video/estilos/*/itens/**"
      ],
      "context_out": [
        "cenas.json"
      ],
      "output": {
        "artifact": "cenas.json",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-E09.1..AC-E09.5",
      "status": "done",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 300
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "exit_code == 0"
      },
      "depends_on": [
        "n02_contratos_v2"
      ]
    },
    {
      "id": "n04_motor_portado",
      "name": "Motor portado (motor-local, licenca MIT): ponte cenas->timeline, render 9:16 determinstico, boca sincronizada (Epico E10)",
      "nature": "macro",
      "type": "script",
      "command": [
        "legoloop",
        "video-render",
        "timeline",
        "--projeto",
        "projetos/video-diorama/first-brands"
      ],
      "ref": "legoloop video-render timeline",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "timeout_sec": 300,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "inventario/video/estilos/*/*"
      ],
      "context_out": [
        "timeline.json"
      ],
      "output": {
        "artifact": "projetos/video-diorama/first-brands/timeline.json",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-E10.1..AC-E10.8",
      "status": "done",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 300
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "exit_code == 0"
      },
      "depends_on": [
        "n03_peca2_vetorial"
      ]
    },
    {
      "id": "n05_renomeacao_video",
      "name": "Renomeacao diorama->video com alias depreciado, skills/processos/espinha migrados, historico preservado (Epico E11)",
      "nature": "macro",
      "type": "script",
      "command": [
        "legoloop",
        "espinha",
        "verificar",
        "--json"
      ],
      "ref": "legoloop espinha verificar",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "timeout_sec": 300,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "internal/video/*"
      ],
      "context_out": [
        "espinha/registro.json"
      ],
      "output": {
        "artifact": "espinha/registro.json",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-E11.1..AC-E11.4",
      "status": "done",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 300
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "exit_code == 0"
      },
      "depends_on": [
        "n04_motor_portado"
      ]
    },
    {
      "id": "n06_prova_de_reproducao",
      "name": "Prova de reproducao: cena 1 renderizada e aprovada pelo usuario, First Brands reproduzido com ritmo no alvo (Epico E12)",
      "nature": "macro",
      "type": "script",
      "command": [
        "legoloop",
        "video-render",
        "executar",
        "--projeto",
        "projetos/video-diorama/diorama-demo-pilula"
      ],
      "ref": "legoloop video-render executar",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "haiku"
      },
      "timeout_sec": 300,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "timeline.json"
      ],
      "context_out": [
        "renders/cena1.mp4"
      ],
      "output": {
        "artifact": "projetos/video-diorama/diorama-demo-pilula/renders/cena1.mp4",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-E12.1..AC-E12.3",
      "status": "done",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 300
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "exit_code == 0"
      },
      "depends_on": [
        "n05_renomeacao_video"
      ]
    }
  ]
}
