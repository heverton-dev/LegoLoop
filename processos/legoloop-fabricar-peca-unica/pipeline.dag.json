{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "id": "legoloop-fabricar-peca-unica",
  "name": "legoloop-fabricar-peca-unica",
  "description": "Fabricar uma peça única (nó solto) de qualquer tipo, refinar com --adicionar e compor com --depende; triagem só com mais de um nó, exigida por validate e fechar.",
  "version": "1.0.0",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "e01",
      "name": "Processo",
      "type": "skill",
      "nature": "micro",
      "cognitive_complexity": "simples",
      "ref": "skills/legoloop-fabricar-peca-unica",
      "timeout_sec": 600,
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "code-fast"
      },
      "output": {
        "artifact": "out/01_processo.md",
        "gate": "file_exists('out/01_processo.md') \u0026\u0026 word_count('out/01_processo.md') \u003e= 30 \u0026\u0026 !has_pattern('out/01_processo.md', '\\{\\{')"
      },
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local"
      },
      "token_budget": {
        "max_completion_tokens": 3000,
        "max_prompt_tokens": 10000
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_out": [
        "out/01_processo.md"
      ],
      "status": "PENDING"
    }
  ]
}
