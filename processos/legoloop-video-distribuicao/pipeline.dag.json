{
  "$schema": "https://legoloop.dev/schemas/dag.v2.json",
  "id": "legoloop-video-distribuicao",
  "name": "legoloop-video-distribuicao",
  "version": "1.0.0",
  "schema_version": 2,
  "date": "2026-11-27",
  "description": "Processo canonizado P4 do processo composto legoloop-video-animado: revisao com parecer, vitrine, acervo com agenda quente e perene, publicacao pelo Postiz (privada por padrao), comentarios com aprovacao e aprendizado semanal.",
  "upstream_signatures": {
    "intent": "docs/intents/2026-11-27_INTENT_VIDEO_DISTRIBUICAO.md",
    "spec": "docs/specs/2026-11-27_SPEC_VIDEO_DISTRIBUICAO.md",
    "plan": "docs/plans/2026-11-27_PLAN_VIDEO_DISTRIBUICAO.md",
    "route": "docs/routes/2026-11-27_ROUTE_VIDEO_DISTRIBUICAO.json"
  },
  "execution_strategy": {
    "supervision_level": "micro",
    "concurrency": {
      "mode": "sequential",
      "max_parallel_subagents": 1,
      "harness_capability": "subagent_cli_isolated"
    },
    "default_isolation": {
      "workspace": "local",
      "executor": "orchestrix_hermetic",
      "subagents_allowed": false
    },
    "max_parallel_workers": 1,
    "tdd_enforced": true,
    "default_timeout_sec": 300,
    "rollback_on_failure": "abort_and_pause",
    "rollback_policy": {
      "action": "abort_and_pause",
      "git_strategy": "none",
      "preserve_artifacts": true,
      "commit_on_node_pass": false
    }
  },
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "n01_prevoo",
      "name": "Pre-voo: pasta acervo, ffmpeg, Pillow e variaveis do Postiz",
      "nature": "micro",
      "type": "script",
      "command": [
        "legoloop",
        "video-distribuicao",
        "prevoo",
        "--projeto",
        "."
      ],
      "ref": "legoloop video-distribuicao prevoo",
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "via": "9router",
        "model": "sonnet",
        "effort": "low",
        "fallback": "haiku"
      },
      "timeout_sec": 60,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "projeto.json"
      ],
      "context_out": [
        "acervo/"
      ],
      "output": {
        "artifact": "acervo/",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-E07.1",
      "status": "pending",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 60
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "exit_code == 0"
      }
    },
