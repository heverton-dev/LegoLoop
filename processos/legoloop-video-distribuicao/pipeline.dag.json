      "spec_ref": "AC-E03.1",
      "status": "pending",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 60
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "exit_code == 0"
      }
    },
