      "context_out": [
        "review/sheet_01.jpg",
        "review/v1_pacote.json"
      ],
      "output": {
        "artifact": "review/v1_pacote.json",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-E03.3",
      "status": "pending",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_attempts": 1,
        "timeout_seconds": 300
      },
      "rollback_strategy": "abort_and_pause",
      "verification": {
        "gate": "exit_code == 0"
      }
    },
