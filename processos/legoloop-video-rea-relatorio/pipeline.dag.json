{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "id": "legoloop-video-rea-relatorio",
  "name": "legoloop-video-rea-relatorio",
  "description": "Gravar docs/reports/AAAA-MM-DD_REPORT_\u003cslug\u003e.md com frontmatter YAML e as três classes DEVE, PODE e NÃO PODE. Cada item traz o porquê e o como.",
  "version": "1.0.0",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "e01",
      "name": "Skill",
      "type": "skill",
      "nature": "micro",
      "cognitive_complexity": "simples",
      "ref": "skills/legoloop-video-rea-relatorio",
      "timeout_sec": 600,
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "code-fast"
      },
      "output": {
        "artifact": "out/01_skill.md",
        "gate": "file_exists('out/01_skill.md') \u0026\u0026 word_count('out/01_skill.md') \u003e= 30 \u0026\u0026 !has_pattern('out/01_skill.md', '\\{\\{')"
      },
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local"
      },
      "token_budget": {
        "max_completion_tokens": 3000,
        "max_prompt_tokens": 10000
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_out": [
        "out/01_skill.md"
      ],
      "status": "PENDING"
    }
  ]
}
