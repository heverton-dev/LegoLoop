{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "id": "exemplo-loop-spec-plano",
  "name": "exemplo-loop-spec-plano",
  "description": "Loop modular de exemplo: transforma uma INTENT aprovada em SPEC com critérios binários e em PLAN, com Stop-Gate humano antes do BUILD.",
  "version": "2.0.0",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "n01_spec",
      "type": "skill",
      "ref": "skills/aidd-spec",
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "effort": "high",
        "fallback": "code-fast"
      },
      "timeout_sec": 600,
      "execution": {
        "mode": "isolated"
      },
      "inputs": {
        "intent": "file('INTENT.md')"
      },
      "output": {
        "artifact": "SPEC.md",
        "gate": "file_exists('SPEC.md') && has_binary_criteria('SPEC.md') && has_acceptance_criteria('SPEC.md')"
      }
    },
    {
      "id": "n02_plano",
      "type": "skill",
      "ref": "skills/aidd-tickets",
      "depends_on": [
        "n01_spec"
      ],
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "code-fast"
      },
      "timeout_sec": 600,
      "inputs": {
        "n01_spec": "file('SPEC.md')"
      },
      "output": {
        "artifact": "PLAN.md",
        "gate": "file_exists('PLAN.md') && has_binary_criteria('PLAN.md') && prompt('Aprova o PLAN.md para iniciar o BUILD?')"
      }
    }
  ]
}
