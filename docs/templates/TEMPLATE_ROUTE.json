{
  "$schema": "https://legoloop.dev/schemas/route.v2.json",
  "template_version": "2.0.0",
  "name": "{{ROUTE_NAME}}",
  "version": "1.0.0",
  "date": "{{DATA}}",
  "session_id": "00000000-0000-0000-0000-000000000000",
  "intent_ref": "docs/intents/{{DATA}}_INTENT_{{NOME}}.md",
  "spec_ref": "docs/specs/{{DATA}}_SPEC_{{NOME}}.md",
  "plan_ref": "docs/plans/{{DATA}}_PLAN_{{NOME}}.md",
  "execution_strategy": {
    "supervision_level": "micro",
    "default_isolation": {
      "workspace": "local",
      "executor": "orchestrix_hermetic",
      "subagents_allowed": false
    },
    "max_parallel_workers": 2,
    "tdd_enforced": true,
    "default_timeout_sec": 180,
    "rollback_on_failure": "abort_pipeline"
  },
  "nodes": [
    {
      "id": "TICK-01.1",
      "label": "Implementação da Unidade com Red-Green TDD",
      "nature": "micro",
      "type": "unit_task",
      "ref": null,
      "status": "PENDING",
      "execution_mode": "tdd_red_green",
      "isolation": {
        "workspace": "local",
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false
      },
      "timeout_sec": 180,
      "token_budget": {
        "max_output_tokens": 600
      },
      "depends_on": [],
      "routing": {
        "mode": "suggested",
        "harness": "9router",
        "model": "code-pro",
        "effort": "high",
        "fallback": {
          "harness": "antigravity",
          "model": "flash"
        }
      },
      "tooling": {
        "runtime": "powershell",
        "mcps_required": false,
        "mcps_allowed": []
      },
      "inputs": {
        "source_files": [
          "internal/pkg/service.go"
        ],
        "spec_anchor": "docs/specs/{{DATA}}_SPEC_{{NOME}}.md#AC-E01.1",
        "context_artifacts": []
      },
      "spec_ref": "AC-E01.1",
      "test_target": "internal/pkg/service_test.go:TestFeatureCore",
      "defects": [],
      "rollback_strategy": "stash_changes",
      "output": {
        "artifacts": [
          "internal/pkg/service.go",
          "internal/pkg/service_test.go"
        ],
        "verify": [
          ["go", "test", "-v", "./internal/pkg/..."]
        ],
        "gate": "exit_code == 0 && file_exists('internal/pkg/service.go') && file_exists('internal/pkg/service_test.go')"
      }
    },
    {
      "id": "TICK-01.2",
      "label": "Verificação Estática da Unidade",
      "nature": "nano",
      "type": "unit_task",
      "ref": null,
      "status": "PENDING",
      "execution_mode": "sequential",
      "isolation": {
        "workspace": "local",
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false
      },
      "timeout_sec": 180,
      "token_budget": {
        "max_output_tokens": 300
      },
      "depends_on": [
        "TICK-01.1"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "9router",
        "model": "code-nano",
        "effort": "low",
        "fallback": {
          "harness": "antigravity",
          "model": "flash"
        }
      },
      "tooling": {
        "runtime": "powershell",
        "mcps_required": false,
        "mcps_allowed": []
      },
      "inputs": {
        "source_files": [
          "internal/pkg/service.go"
        ],
        "spec_anchor": "docs/specs/{{DATA}}_SPEC_{{NOME}}.md#AC-E01.2",
        "context_artifacts": []
      },
      "spec_ref": "AC-E01.2",
      "test_target": null,
      "defects": [],
      "rollback_strategy": "stash_changes",
      "output": {
        "artifacts": [
          "internal/pkg/service.go"
        ],
        "verify": [
          ["go", "vet", "./internal/pkg/..."]
        ],
        "gate": "exit_code == 0"
      }
    },
    {
      "id": "SG-E01",
      "label": "Stop-Gate Humano do Épico 01",
      "nature": "nano",
      "type": "stop_gate",
      "ref": null,
      "status": "PENDING",
      "execution_mode": "sequential",
      "isolation": {
        "workspace": "local",
        "executor": "local_process",
        "subagents_allowed": false
      },
      "timeout_sec": 180,
      "token_budget": {
        "max_output_tokens": 0
      },
      "depends_on": [
        "TICK-01.1",
        "TICK-01.2"
      ],
      "routing": {
        "mode": "manual",
        "harness": "local",
        "model": "human/operator",
        "effort": null,
        "fallback": null
      },
      "tooling": {
        "runtime": "powershell",
        "mcps_required": false,
        "mcps_allowed": []
      },
      "inputs": {
        "source_files": [],
        "spec_anchor": null,
        "context_artifacts": []
      },
      "spec_ref": null,
      "test_target": null,
      "defects": [],
      "rollback_strategy": "abort_pipeline",
      "output": {
        "artifacts": [],
        "verify": [],
        "gate": "prompt('Evidências do Épico 01 aprovadas? Autoriza iniciar o Épico 02?')"
      }
    },
    {
      "id": "TICK-02.1",
      "label": "Dissecação via Subloop Especialista",
      "nature": "macro",
      "type": "subloop",
      "ref": "exemplo-subloop",
      "status": "PENDING",
      "execution_mode": "sequential",
      "isolation": {
        "workspace": "tempdir",
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false
      },
      "timeout_sec": 300,
      "token_budget": {
        "max_output_tokens": 1200
      },
      "depends_on": [
        "SG-E01"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "9router",
        "model": "code-fast",
        "effort": "medium",
        "fallback": {
          "harness": "ollama",
          "model": "deepseek-coder:6.7b"
        }
      },
      "tooling": {
        "runtime": "powershell",
        "mcps_required": true,
        "mcps_allowed": [
          "codebase-memory-mcp:search_code"
        ]
      },
      "inputs": {
        "source_files": [],
        "spec_anchor": "docs/specs/{{DATA}}_SPEC_{{NOME}}.md#AC-E02.1",
        "context_artifacts": [
          "scratch/target_analysis.json"
        ]
      },
      "spec_ref": "AC-E02.1",
      "test_target": null,
      "defects": [],
      "rollback_strategy": "stash_changes",
      "output": {
        "artifacts": [
          "scratch/subloop_output.json"
        ],
        "verify": [],
        "gate": "file_exists('scratch/subloop_output.json')"
      }
    },
    {
      "id": "SG-FINAL",
      "label": "Homologação Final (Regressão Global & Recompilação Fresca)",
      "nature": "nano",
      "type": "stop_gate",
      "ref": null,
      "status": "PENDING",
      "execution_mode": "sequential",
      "isolation": {
        "workspace": "local",
        "executor": "local_process",
        "subagents_allowed": false
      },
      "timeout_sec": 180,
      "token_budget": {
        "max_output_tokens": 0
      },
      "depends_on": [
        "TICK-02.1"
      ],
      "routing": {
        "mode": "manual",
        "harness": "local",
        "model": "script/local",
        "effort": null,
        "fallback": null
      },
      "tooling": {
        "runtime": "powershell",
        "mcps_required": false,
        "mcps_allowed": []
      },
      "inputs": {
        "source_files": [
          "cmd/legoloop/main.go"
        ],
        "spec_anchor": null,
        "context_artifacts": []
      },
      "spec_ref": null,
      "test_target": null,
      "defects": [],
      "rollback_strategy": "abort_pipeline",
      "output": {
        "artifacts": [
          "bin/legoloop.exe"
        ],
        "verify": [
          ["go", "test", "./..."],
          ["go", "vet", "./..."],
          ["go", "build", "-o", "bin/legoloop.exe", "./cmd/legoloop"]
        ],
        "gate": "exit_code == 0 && file_exists('bin/legoloop.exe')"
      }
    }
  ]
}
