{
  "harness_support": ["any"],
  "os_support": ["windows", "linux", "macos"],
  "execution_modes": ["cli", "agente", "estudio"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "legoloop hook guard-write-boundary",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "legoloop hook post-format-linter",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
