{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "hook-padrao-ouro",
  "version": "1.0.0",
  "description": "Hook determinístico com fail-safe e sanitização de credenciais",
  "tier": "ouro",
  "event": "pre_tool_call",
  "execution": {
    "mode": "synchronous_fail_safe",
    "timeout_ms": 3000,
    "command": "powershell -NoProfile -File ./scripts/sanitize_payload.ps1"
  },
  "security": {
    "redact_env_vars": true,
    "block_on_secret_leak": true
  },
  "conditions": {
    "file_pattern": "**/*.go"
  }
}
