{
  "$schema": "https://legoloop.dev/schemas/dag.v1.json",
  "id": "legoloop-swarm",
  "name": "legoloop-swarm",
  "description": "Orquestrar execucao paralela de pipeline.dag.json em swarm por nivel topologico com roteamento de modelos pela Matriz de Papeis",
  "version": "1.0.0",
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "e01",
      "name": "Etapa 1",
      "type": "skill",
      "nature": "micro",
      "cognitive_complexity": "simples",
      "ref": "skills/legoloop-piece-upgrader",
      "timeout_sec": 600,
      "routing": {
        "mode": "suggested",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "code-fast"
      },
      "output": {
        "artifact": "out/01_etapa.md",
        "gate": "file_exists('out/01_etapa.md') \u0026\u0026 word_count('out/01_etapa.md') \u003e= 30 \u0026\u0026 !has_pattern('out/01_etapa.md', '\\{\\{')"
      },
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local"
      },
      "token_budget": {
        "max_completion_tokens": 3000,
        "max_prompt_tokens": 10000
      },
      "tooling": {
        "runtime": "powershell"
      },
      "context_out": [
        "out/01_etapa.md"
      ],
      "status": "PENDING"
    },
    {
