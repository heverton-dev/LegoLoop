      "context_out": [
        "docs/dags/2026-11-07_DAG_LEGOLOOP_FECHAR.json",
        "docs/dags/2026-11-07_DAG_LEGOLOOP_VIDEO_MOTION.json",
        "docs/dags/2026-11-08_DAG_LEGOLOOP_VIDEO_EDITION.json",
        "docs/dags/2026-11-09_DAG_LEGOLOOP_VIDEO_REA.json"
