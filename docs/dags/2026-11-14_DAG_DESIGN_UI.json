{
  "$schema": "https://legoloop.dev/schemas/dag.v2.json",
  "schema_version": 2,
  "name": "legoloop-design-ui",
  "description": "Processo especializado de UI/UX, motion scroll e 3D web integrando aidd-uiux, impeccable, emilkowalski-skills, aidd-dataviz, aidd-linter-design, web-perf e gates responsivos",
  "version": "1.0.0",
  "date": "2026-11-14",
  "upstream_signatures": {
    "route": {
      "path": "docs/routes/2026-11-14_ROUTE_DESIGN_UI.json",
      "sha256": "9d11c4e65f400209f4e68da81aa63ad1ae282bf9768fb1ade54972e60b1acc8b"
    }
  },
  "execution_strategy": {
    "supervision_level": "epic",
    "max_parallel_workers": 2,
    "default_timeout_sec": 180,
    "rollback_on_failure": "abort_pipeline"
  },
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "TICK-01.1",
      "name": "Planejar — peça frontend-design-direction",
      "type": "unit_no",
      "nature": "micro",
      "role": "engenheiro-frontend",
      "papel": "engenheiro-frontend",
      "cognitive_complexity": "simples",
      "ref": "skills/frontend-design-direction",
      "depends_on": [],
      "timeout_sec": 180,
      "routing": {
        "mode": "suggested",
        "harness": "9router",
        "via": "9router",
        "combo": "t-codigo-128k",
        "model": "t-codigo-128k",
        "effort": "high",
        "fallback": "t-agente-128k"
      },
      "execution": {
        "mode": "isolated"
      },
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "limits": {
        "max_output_tokens": 600
      },
      "token_budget": {
        "max_completion_tokens": 600,
        "max_prompt_tokens": 16000
      },
      "rollback_strategy": "stash_changes",
      "tooling": {
        "runtime": "legoloop"
      },
      "verification": {
        "gate": "file_exists('out/01_planejar.md') && word_count('out/01_planejar.md') >= 30 && !has_pattern('out/01_planejar.md', '\\{\\{')"
      },
      "spec_ref": "AC-E01.1",
      "status": "PENDING",
      "context_in": [
        "docs/specs/2026-11-14_SPEC_DESIGN_UI.md"
      ],
      "context_out": [
        "out/01_planejar.md"
      ],
      "output": {
        "artifact": "out/01_planejar.md",
        "gate": "file_exists('out/01_planejar.md') && word_count('out/01_planejar.md') >= 30 && !has_pattern('out/01_planejar.md', '\\{\\{')"
      }
    },
    {
      "id": "SG-FINAL",
      "name": "Homologação Final",
      "type": "stop_gate",
      "nature": "nano",
      "depends_on": [
        "TICK-01.1"
      ],
      "timeout_sec": 180,
      "routing": {
        "mode": "manual",
        "harness": "local",
        "via": "oficial",
        "model": "script/local",
        "effort": "low"
      },
      "execution": {
        "mode": "inline"
      },
      "isolation": {
        "executor": "local_process",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "limits": {
        "max_output_tokens": 300
      },
      "rollback_strategy": "abort_pipeline",
      "tooling": {
        "runtime": "legoloop"
      },
      "verification": {
        "gate": "exit_code == 0 && file_exists('bin/legoloop.exe')"
      },
      "spec_ref": "AC-E01.1",
      "status": "PENDING",
      "context_in": [
        "cmd/legoloop/main.go"
      ],
      "context_out": [
        "bin/legoloop.exe"
      ],
      "output": {
        "artifact": "bin/legoloop.exe",
        "gate": "exit_code == 0 && file_exists('bin/legoloop.exe')"
      }
    }
  ]
}
