        "mode": "suggested",
        "harness": "claude",
        "via": "oficial",
        "model": "sonnet",
        "effort": "low",
        "fallback": "haiku"
      },
      "timeout_sec": 30,
      "execution": {
        "mode": "isolated"
      },
      "inputs": {
        "alvo": "var.alvo"
      },
      "output": {
        "artifact": "target_resolved.json",
        "gate": "file_exists('target_resolved.json')"
      },
      "name": "n01_resolver_alvo",
      "nature": "micro",
      "context_in": [],
      "context_out": [
        "target_resolved.json"
      ],
      "isolation": {
        "write_boundary": "strict",
        "workspace": "local",
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false
      },
      "limits": {
        "max_completion_tokens": 600,
        "max_duration_sec": 180,
        "max_prompt_tokens": 16000
      },
      "rollback_strategy": "stash_changes",
      "tooling": {
        "harness": "claude",
        "mcps_allowed": [],
        "mcps_required": false,
        "runtime": "powershell"
      },
      "verification": {
        "exit_code": 0,
        "gate": "file_exists('target_resolved.json')"
      },
      "spec_ref": "n01_resolver_alvo",
      "status": "PENDING"
