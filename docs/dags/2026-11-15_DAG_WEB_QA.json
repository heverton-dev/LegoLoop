{
  "$schema": "https://legoloop.dev/schemas/dag.v2.json",
  "schema_version": 2,
  "id": "legoloop-web-qa",
  "name": "legoloop-web-qa",
  "version": "1.1.0",
  "date": "2026-11-15",
  "description": "Processo canônico web-qa para auditoria determinística de web apps (playwright, obscura, aidd-linter-design, renderlint, axe-core, unlighthouse, lychee e lost-pixel), com relatório consolidado em docs/qa-web/ e encadeamento obrigatório para entrevista socrática até BUILD.",
  "upstream_signatures": {
    "route": {
      "path": "docs/routes/2026-11-15_ROUTE_WEB_QA.json",
      "sha256": "67bbac8d1f6e257f6980b4137b555da775d80efabdb996ce924d74cdb6810b1b"
    }
  },
  "execution_strategy": {
    "supervision_level": "micro",
    "max_parallel_workers": 4,
    "default_timeout_sec": 300,
    "rollback_on_failure": "abort_processo"
  },
  "trigger": {
    "type": "manual"
  },
  "nodes": [
    {
      "id": "n01_preflight",
      "name": "Preflight estrito das 8 ferramentas obrigatórias",
      "type": "script",
      "nature": "nano",
      "command": [
        "node",
        "tools/webqa/webqa.mjs",
        "preflight",
        "--json"
      ],
      "depends_on": [],
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "model": "haiku",
        "effort": "low",
        "fallback": "sonnet",
        "via": "oficial"
      },
      "timeout_sec": 60,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "node"
      },
      "context_in": [],
      "context_out": [
        "scratch/webqa/preflight.json"
      ],
      "output": {
        "artifact": "scratch/webqa/preflight.json",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-n01_preflight",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "verification": {
        "gate": "exit_code == 0"
      }
    },
    {
      "id": "n02_boot_e_descoberta",
      "name": "Boot opcional de app local e descoberta de rotas e viewports",
      "type": "script",
      "nature": "micro",
      "command": [
        "node",
        "tools/webqa/webqa.mjs",
        "discover",
        "--url",
        "var.target_url"
      ],
      "depends_on": [
        "n01_preflight"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "model": "haiku",
        "effort": "low",
        "fallback": "sonnet",
        "via": "oficial"
      },
      "timeout_sec": 120,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "node"
      },
      "context_in": [
        "scratch/webqa/preflight.json"
      ],
      "context_out": [
        "scratch/webqa/routes_manifest.json"
      ],
      "output": {
        "artifact": "scratch/webqa/routes_manifest.json",
        "gate": "exit_code == 0 && file_exists('scratch/webqa/routes_manifest.json')"
      },
      "spec_ref": "AC-n02_boot_e_descoberta",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "verification": {
        "gate": "exit_code == 0 && file_exists('scratch/webqa/routes_manifest.json')"
      }
    },
    {
      "id": "n03_links_lychee",
      "name": "Auditoria determinística de links e assets com lychee",
      "type": "script",
      "nature": "micro",
      "command": [
        "lychee",
        "--format",
        "json",
        "--no-progress",
        "var.target_url"
      ],
      "depends_on": [
        "n02_boot_e_descoberta"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "model": "haiku",
        "effort": "low",
        "fallback": "sonnet",
        "via": "oficial"
      },
      "timeout_sec": 180,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "scratch/webqa/routes_manifest.json"
      ],
      "context_out": [
        "scratch/webqa/lychee.json"
      ],
      "output": {
        "artifact": "scratch/webqa/lychee.json",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-n03_links_lychee",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "verification": {
        "gate": "exit_code == 0"
      }
    },
    {
      "id": "n04_obscura_e_playwright",
      "name": "Inspeção de rotas, console e navegação com obscura e playwright",
      "type": "script",
      "nature": "micro",
      "command": [
        "obscura",
        "--allow-private-network",
        "fetch",
        "var.target_url"
      ],
      "depends_on": [
        "n02_boot_e_descoberta"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "opus",
        "via": "oficial"
      },
      "timeout_sec": 300,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "node"
      },
      "context_in": [
        "scratch/webqa/routes_manifest.json"
      ],
      "context_out": [
        "scratch/webqa/playwright_obscura.json"
      ],
      "output": {
        "artifact": "scratch/webqa/playwright_obscura.json",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-n04_obscura_e_playwright",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "verification": {
        "gate": "exit_code == 0"
      }
    },
    {
      "id": "n05_renderlint_e_design",
      "name": "Auditoria de botões mortos, layout e tokens com renderlint e aidd-linter-design",
      "type": "skill",
      "nature": "micro",
      "ref": "skills/aidd-linter-design",
      "depends_on": [
        "n02_boot_e_descoberta"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "opus",
        "via": "oficial"
      },
      "timeout_sec": 300,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "node"
      },
      "context_in": [
        "scratch/webqa/routes_manifest.json"
      ],
      "context_out": [
        "scratch/webqa/renderlint_design.json"
      ],
      "output": {
        "artifact": "scratch/webqa/renderlint_design.json",
        "gate": "exit_code == 0 && file_exists('scratch/webqa/renderlint_design.json')"
      },
      "spec_ref": "AC-n05_renderlint_e_design",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "verification": {
        "gate": "exit_code == 0 && file_exists('scratch/webqa/renderlint_design.json')"
      }
    },
    {
      "id": "n06_axe_acessibilidade",
      "name": "Auditoria de acessibilidade WCAG (critical e serious) com axe-core",
      "type": "script",
      "nature": "micro",
      "command": [
        "axe",
        "var.target_url",
        "--exit"
      ],
      "depends_on": [
        "n02_boot_e_descoberta"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "model": "haiku",
        "effort": "low",
        "fallback": "sonnet",
        "via": "oficial"
      },
      "timeout_sec": 240,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "node"
      },
      "context_in": [
        "scratch/webqa/routes_manifest.json"
      ],
      "context_out": [
        "scratch/webqa/axe.json"
      ],
      "output": {
        "artifact": "scratch/webqa/axe.json",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-n06_axe_acessibilidade",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "verification": {
        "gate": "exit_code == 0"
      }
    },
    {
      "id": "n07_unlighthouse_rotas",
      "name": "Varredura Lighthouse multi-rota (nota mínima 90) com unlighthouse",
      "type": "script",
      "nature": "micro",
      "command": [
        "unlighthouse-ci",
        "--site",
        "var.target_url",
        "--budget",
        "90"
      ],
      "depends_on": [
        "n02_boot_e_descoberta"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "model": "haiku",
        "effort": "low",
        "fallback": "sonnet",
        "via": "oficial"
      },
      "timeout_sec": 600,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "node"
      },
      "context_in": [
        "scratch/webqa/routes_manifest.json"
      ],
      "context_out": [
        "scratch/webqa/unlighthouse.json"
      ],
      "output": {
        "artifact": "scratch/webqa/unlighthouse.json",
        "gate": "exit_code == 0"
      },
      "spec_ref": "AC-n07_unlighthouse_rotas",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "verification": {
        "gate": "exit_code == 0"
      }
    },
    {
      "id": "n08_lost_pixel_visual",
      "name": "Regressão visual open-source e snapshot inicial com lost-pixel",
      "type": "script",
      "nature": "micro",
      "command": [
        "lost-pixel"
      ],
      "depends_on": [
        "n04_obscura_e_playwright"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "opus",
        "via": "oficial"
      },
      "timeout_sec": 300,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "node"
      },
      "context_in": [
        "scratch/webqa/playwright_obscura.json"
      ],
      "context_out": [
        "scratch/webqa/lost_pixel.json"
      ],
      "output": {
        "artifact": "scratch/webqa/lost_pixel.json",
        "gate": "file_exists('scratch/webqa/lost_pixel.json')"
      },
      "spec_ref": "AC-n08_lost_pixel_visual",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "verification": {
        "gate": "file_exists('scratch/webqa/lost_pixel.json')"
      }
    },
    {
      "id": "n09_sg_baseline_visual",
      "name": "Stop-Gate humano de promoção da baseline visual (lost-pixel)",
      "type": "stop_gate",
      "nature": "nano",
      "depends_on": [
        "n08_lost_pixel_visual"
      ],
      "routing": {
        "mode": "manual",
        "harness": "claude",
        "model": "haiku",
        "effort": "low",
        "fallback": "sonnet",
        "via": "oficial"
      },
      "timeout_sec": 3600,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "context_in": [
        "scratch/webqa/lost_pixel.json"
      ],
      "context_out": [
        "scratch/webqa/baseline_aprovada.json"
      ],
      "output": {
        "artifact": "scratch/webqa/baseline_aprovada.json",
        "gate": "prompt('Aprovar baseline visual ou confirmar diff do lost-pixel?')"
      },
      "spec_ref": "AC-n09_sg_baseline_visual",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "tooling": {
        "runtime": "legoloop"
      },
      "verification": {
        "gate": "prompt('Aprovar baseline visual ou confirmar diff do lost-pixel?')"
      }
    },
    {
      "id": "n10_relatorio_consolidado",
      "name": "Consolidação de relatório JSON + Markdown em docs/qa-web/",
      "type": "script",
      "nature": "micro",
      "command": [
        "node",
        "tools/webqa/webqa.mjs",
        "run",
        "--url",
        "var.target_url",
        "--alvo",
        "var.alvo"
      ],
      "depends_on": [
        "n03_links_lychee",
        "n05_renderlint_e_design",
        "n06_axe_acessibilidade",
        "n07_unlighthouse_rotas",
        "n09_sg_baseline_visual"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "model": "sonnet",
        "effort": "medium",
        "fallback": "opus",
        "via": "oficial"
      },
      "timeout_sec": 600,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "node"
      },
      "context_in": [
        "scratch/webqa/lychee.json",
        "scratch/webqa/renderlint_design.json",
        "scratch/webqa/axe.json",
        "scratch/webqa/unlighthouse.json",
        "scratch/webqa/baseline_aprovada.json"
      ],
      "context_out": [
        "docs/qa-web/RELATORIO_QA_WEB.json",
        "docs/qa-web/RELATORIO_QA_WEB.md"
      ],
      "output": {
        "artifact": "docs/qa-web/RELATORIO_QA_WEB.md",
        "gate": "file_exists('docs/qa-web/RELATORIO_QA_WEB.md') && file_exists('docs/qa-web/RELATORIO_QA_WEB.json')"
      },
      "spec_ref": "AC-n10_relatorio_consolidado",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "verification": {
        "gate": "file_exists('docs/qa-web/RELATORIO_QA_WEB.md') && file_exists('docs/qa-web/RELATORIO_QA_WEB.json')"
      }
    },
    {
      "id": "n11_entrevista_correcao",
      "name": "Entrevista socrática de afunilamento sobre correções do relatório",
      "type": "skill",
      "nature": "micro",
      "ref": "skills/aidd-grill",
      "depends_on": [
        "n10_relatorio_consolidado"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "model": "sonnet",
        "effort": "high",
        "fallback": "opus",
        "via": "oficial"
      },
      "timeout_sec": 900,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "docs/qa-web/RELATORIO_QA_WEB.md",
        "docs/qa-web/RELATORIO_QA_WEB.json"
      ],
      "context_out": [
        "scratch/webqa/INTERVIEW_CORRECAO.md"
      ],
      "output": {
        "artifact": "scratch/webqa/INTERVIEW_CORRECAO.md",
        "gate": "file_exists('scratch/webqa/INTERVIEW_CORRECAO.md') && word_count('scratch/webqa/INTERVIEW_CORRECAO.md') >= 50"
      },
      "spec_ref": "AC-n11_entrevista_correcao",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "verification": {
        "gate": "file_exists('scratch/webqa/INTERVIEW_CORRECAO.md') && word_count('scratch/webqa/INTERVIEW_CORRECAO.md') >= 50"
      }
    },
    {
      "id": "n12_governanca_build",
      "name": "Geração da cadeia INTERVIEW -> INTENT -> SPEC -> PLAN -> ROUTE -> DAG -> SWARM para BUILD",
      "type": "skill",
      "nature": "micro",
      "ref": "skills/legoloop-fabricar",
      "depends_on": [
        "n11_entrevista_correcao"
      ],
      "routing": {
        "mode": "suggested",
        "harness": "claude",
        "model": "opus",
        "effort": "high",
        "fallback": "sonnet",
        "via": "oficial"
      },
      "timeout_sec": 900,
      "isolation": {
        "executor": "orchestrix_hermetic",
        "subagents_allowed": false,
        "workspace": "local",
        "write_boundary": "strict"
      },
      "tooling": {
        "runtime": "legoloop"
      },
      "context_in": [
        "scratch/webqa/INTERVIEW_CORRECAO.md",
        "docs/qa-web/RELATORIO_QA_WEB.json"
      ],
      "context_out": [
        "docs/qa-web/PACOTE_BUILD_SWARM.json"
      ],
      "output": {
        "artifact": "docs/qa-web/PACOTE_BUILD_SWARM.json",
        "gate": "file_exists('docs/qa-web/PACOTE_BUILD_SWARM.json')"
      },
      "spec_ref": "AC-n12_governanca_build",
      "status": "PENDING",
      "execution": {
        "mode": "isolated"
      },
      "limits": {
        "max_output_tokens": 1200
      },
      "rollback_strategy": "stash_changes",
      "verification": {
        "gate": "file_exists('docs/qa-web/PACOTE_BUILD_SWARM.json')"
      }
    }
  ]
}
